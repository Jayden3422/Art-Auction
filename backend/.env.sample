# Server ports
APP_PORT=3000
WS_PORT=3001
# Reverse proxy trust for Express (examples: 1, true, loopback, false)
TRUST_PROXY=loopback

# MongoDB
MONGO_URL=mongodb://localhost:27017/
MONGO_DB_NAME=liujinqi

# JWT
JWT_SALT=replace_with_a_long_random_secret

# SEO: Public site URL for sitemap generation
SITE_URL=https://example.com

# Aliyun OSS
OSS_REGION=oss-cn-beijing
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=your_bucket_name
