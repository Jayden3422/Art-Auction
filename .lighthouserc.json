{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "url": [
        "http://127.0.0.1:3000/login",
        "http://127.0.0.1:3000/signin",
        "http://127.0.0.1:3000/home/auction?__seo=1",
        "http://127.0.0.1:3000/home/auction/upcoming?__seo=1",
        "http://127.0.0.1:3000/home/auction/live?__seo=1",
        "http://127.0.0.1:3000/home/auction/ended?__seo=1"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.75
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.5
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
